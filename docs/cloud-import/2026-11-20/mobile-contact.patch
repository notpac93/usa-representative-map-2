+class _RotatingLeaderPortraits extends StatefulWidget {
+  const _RotatingLeaderPortraits();
+
+  @override
+  State<_RotatingLeaderPortraits> createState() =>
+      _RotatingLeaderPortraitsState();
+}
+
+class _RotatingLeaderPortraitsState extends State<_RotatingLeaderPortraits> {
+  static const _groups = [
+    [
+      'senators/ak-lisa-murkowski.jpg',
+      'senators/nj-cory-a-booker.jpg',
+      'representatives/CA-doris-matsui.jpg',
+    ],
+    [
+      'senators/il-tammy-duckworth.jpg',
+      'senators/sd-john-thune.jpg',
+      'representatives/NY-hakeem-jeffries.jpg',
+    ],
+    [
+      'senators/al-katie-boyd-britt.png',
+      'senators/ga-raphael-g-warnock.jpg',
+      'representatives/CA-nanette-barragan.jpg',
+    ],
+  ];
+
+  Timer? _timer;
+  int _groupIndex = 0;
+
+  @override
+  void didChangeDependencies() {
+    super.didChangeDependencies();
+    if (MediaQuery.disableAnimationsOf(context) || !TickerMode.of(context)) {
+      _timer?.cancel();
+      _timer = null;
+      return;
+    }
+
+    _timer ??= Timer.periodic(const Duration(seconds: 6), (_) {
+      setState(() => _groupIndex = (_groupIndex + 1) % _groups.length);
+    });
+  }
+
+  @override
+  void dispose() {
+    _timer?.cancel();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Row(
+      children: [
+        for (final photo in _groups[_groupIndex])
+          Expanded(
+            child: Image.asset(
+              'assets/img/$photo',
+              height: double.infinity,
+              fit: BoxFit.cover,
+              gaplessPlayback: true,
+              excludeFromSemantics: true,
+            ),
+          ),
+      ],
+    );
+  }
+}
