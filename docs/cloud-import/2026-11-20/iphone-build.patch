+    final client = MockClient((request) async {
+      final Object payload = request.url.path.endsWith('/index.json')
+          ? {
+              'schema': 1,
+              'checkedAt': '2025-05-01T13:00:00Z',
+              'congresses': [
+                {
+                  'congress': 119,
